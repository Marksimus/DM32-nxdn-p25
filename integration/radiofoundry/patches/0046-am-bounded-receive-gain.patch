+#if CONFIG_AM_RX
+// FD6818 0x13 gain steps, relative to 0x03FF (RadioFoundry ad79ab67, hardware-dm32.md 8.7).
+// The ceiling is the word already in use, so weak signals keep their previous gain, rather than gaining 12 dB.
+static const struct {
+	uint16_t word;
+	int8_t db;
+} agc_table[] = {
+	{ 0x000, -93 }, { 0x008, -91 }, { 0x010, -88 }, { 0x001, -87 }, { 0x009, -85 }, { 0x011, -82 }, { 0x002, -81 },
+	{ 0x00A, -79 }, { 0x012, -76 }, { 0x003, -75 }, { 0x00B, -73 }, { 0x013, -70 }, { 0x004, -69 }, { 0x00C, -67 },
+	{ 0x00D, -64 }, { 0x01C, -61 }, { 0x01D, -58 }, { 0x01E, -55 }, { 0x01F, -52 }, { 0x03E, -50 }, { 0x03F, -47 },
+	{ 0x05E, -45 }, { 0x05F, -42 }, { 0x07E, -40 }, { 0x07F, -37 }, { 0x09F, -34 }, { 0x0BF, -32 }, { 0x0DF, -30 },
+	{ 0x0FF, -28 }, { 0x1DF, -26 }, { 0x1FF, -24 }, { 0x2BF, -23 }, { 0x2DF, -21 }, { 0x2FF, -19 }, { 0x35E, -17 },
+	{ 0x35F, -14 }, { 0x37E, -12 }, { 0x37F, -9 }, { 0x38F, -6 }, { 0x3BF, -4 }, { 0x3DF, -2 }, { 0x3FF, 0 },
+};
+#define AGC_N		(uint8_t)(sizeof(agc_table) / sizeof(agc_table[0]))
+#define AGC_NO_PREV	0xFFFFu
+#define AGC_DISABLED	0xFFu
+#define AGC_RELEASE_MARGIN	12u	// 6 dB hysteresis in the RSSI's 0.5 dB units
+
+bool fd6818_agc_reset(fd6818_agc_t *a, uint16_t ceiling_word)
+{
+	a->idx = 0;
+	a->ceiling = AGC_DISABLED;
+	a->hold = 0;
+	a->prev = AGC_NO_PREV;
+	for (uint8_t i = 0; i < AGC_N; i++) {
+		if (agc_table[i].word == ceiling_word) {
+			a->idx = a->ceiling = i;
+			return true;
+		}
+	}
+	return false;
+}
+
+bool fd6818_agc_step(fd6818_agc_t *a, uint16_t r67)
+{
+	if (a->ceiling == AGC_DISABLED) {
+		return false;
+	}
+	uint16_t raw = r67 & 0x1FFu;
+	uint16_t avg = a->prev == AGC_NO_PREV ? raw : (uint16_t)((raw + a->prev) / 2u);
+	a->prev = raw;
+	uint8_t idx = a->idx;
+	if (a->hold > 0) {
+		a->hold--;
+	}
+	if (avg >= FD6818_AGC_TARGET + 2u) {
+		int want = agc_table[idx].db - (int)((avg - FD6818_AGC_TARGET) / 2u);
+		while (idx > 0 && agc_table[idx].db > want) {
+			idx--;
+		}
+		a->hold = FD6818_AGC_HOLD;
+	} else if (avg + AGC_RELEASE_MARGIN < FD6818_AGC_TARGET) {
+		if (a->hold == 0 && idx < a->ceiling) {
+			idx++;
+		}
+	} else {
+		a->hold = FD6818_AGC_HOLD;
+	}
+	bool changed = idx != a->idx;
+	a->idx = idx;
+	if (changed) {
+		// The next reading is at a different gain. Mixing it with the old reading caused repeated excess cuts.
+		a->prev = AGC_NO_PREV;
+	}
+	return changed;
+}
+
+uint16_t fd6818_agc_word(const fd6818_agc_t *a)
+{
+	return agc_table[a->idx].word;
+}
+
+uint8_t fd6818_agc_atten_db(const fd6818_agc_t *a)
+{
+	return a->ceiling == AGC_DISABLED ? 0u : (uint8_t)(agc_table[a->ceiling].db - agc_table[a->idx].db);
+}
+
+uint8_t fd6818_am_status(fd6818_t *dev, uint16_t r67)
+{
+	if (!dev->am) {
+		return 0;
+	}
+	uint8_t atten = fd6818_agc_atten_db(&dev->agc);
+	if (fd6818_agc_step(&dev->agc, r67)) {
+		fd6818_write(dev, FD6818_REG_GAIN, fd6818_agc_word(&dev->agc));
+	}
+	return atten;
+}
+#endif
 
