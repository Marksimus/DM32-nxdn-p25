+#if CONFIG_AM_RX
+// The receiver model follows every applied gain step. Constant-RSSI tests alone missed the withdrawn AM loop's
+// extra cuts and slow recovery: the sample before a gain change must not be averaged with the sample after it.
+static uint16_t am_reading(const fd6818_agc_t *a, int source)
+{
+	int raw = source - 2 * fd6818_agc_atten_db(a);
+	return (uint16_t)(raw < 0 ? 0 : raw > 511 ? 511 : raw);
+}
+
+static void test_am_agc(void)
+{
+	fd6818_agc_t a;
+	CHECK(fd6818_agc_reset(&a, 0x037E));
+	CHECK(fd6818_agc_atten_db(&a) == 0 && fd6818_agc_word(&a) == 0x037E);
+	CHECK(fd6818_agc_step(&a, 222));
+	CHECK(fd6818_agc_atten_db(&a) == 40);
+	CHECK(!fd6818_agc_step(&a, 142));	// no second cut from the old, high-gain reading
+	CHECK(fd6818_agc_atten_db(&a) == 40);
+
+	for (int source = 0; source <= 511; source++) {
+		CHECK(fd6818_agc_reset(&a, 0x037E));
+		for (int k = 0; k < 120; k++) {
+			(void)fd6818_agc_step(&a, am_reading(&a, source));
+			CHECK(a.idx <= a.ceiling && fd6818_agc_atten_db(&a) <= 81);
+		}
+		if (source <= 143) {
+			CHECK(fd6818_agc_atten_db(&a) == 0);	// no boost and no attenuation of weak stations
+		} else if (source <= 304) {
+			CHECK(am_reading(&a, source) >= 136 && am_reading(&a, source) <= 143);
+		} else {
+			CHECK(fd6818_agc_atten_db(&a) == 81);	// table bound, never an index wrap
+		}
+		uint8_t settled = a.idx;
+		for (int k = 0; k < 60; k++) {
+			CHECK(!fd6818_agc_step(&a, am_reading(&a, source)));
+			CHECK(a.idx == settled);	// no steady-state gain pumping
+		}
+	}
+
+	CHECK(fd6818_agc_reset(&a, 0x037E));
+	for (int k = 0; k < 20; k++) {
+		(void)fd6818_agc_step(&a, am_reading(&a, 260));
+	}
+	CHECK(fd6818_agc_atten_db(&a) == 61);
+	unsigned recovered = 0;
+	while (fd6818_agc_atten_db(&a) && recovered < 80) {
+		(void)fd6818_agc_step(&a, am_reading(&a, 120));
+		recovered++;
+	}
+	CHECK(recovered <= FD6818_AGC_HOLD + 42 && fd6818_agc_word(&a) == 0x037E);
+	for (int k = 0; k < 100; k++) {
+		CHECK(!fd6818_agc_step(&a, 0));
+		CHECK(fd6818_agc_word(&a) == 0x037E);
+	}
+	// Unknown gain words are preserved. High, non-RSSI bits do not change the result.
+	CHECK(!fd6818_agc_reset(&a, 0x1234));
+	CHECK(!fd6818_agc_step(&a, 511) && fd6818_agc_atten_db(&a) == 0);
+	CHECK(fd6818_agc_reset(&a, 0x03DF));
+	CHECK(fd6818_agc_step(&a, (uint16_t)(0xFE00u | 222u)));
+	CHECK(fd6818_agc_atten_db(&a) >= 40);
+}
