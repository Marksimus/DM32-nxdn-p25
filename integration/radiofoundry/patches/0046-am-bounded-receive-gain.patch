+	fd6818_t dev;
+	reset_chip();
+	fd6818_attach(&dev, bus());
+	fd6818_set_mode(&dev, FD6818_MODE_FM);
+	fd6818_set_bandwidth(&dev, FD6818_BW_FM_12K5);
+	chip.regs[0x4A] = 0x4567;
+	fd6818_set_am(&dev, true);
+	CHECK(chip.regs[0x13] == 0x037E);
+	CHECK(chip.regs[0x47] == 0x0740 && chip.regs[0x43] == 0x4008);
+	CHECK(chip.regs[0x4A] == 0x4567 && chip.regs[0x48] == 0xBBBF);
+	chip.n = 0;
+	CHECK(fd6818_am_status(&dev, 222) == 0);	// compensation belongs to the gain BEFORE this poll's cut
+	CHECK(chip.n == 1 && chip.log[0].reg == FD6818_REG_GAIN && chip.log[0].val == 0x001F);
+	CHECK(fd6818_am_status(&dev, 142) == 40);
+	CHECK(chip.n == 1);	// no stale-average overcut
+	CHECK(fd6818_rssi_dbm(222) == fd6818_rssi_dbm(142) + 40);	// same squelch level after the cut
+	fd6818_set_am(&dev, true);	// another AM tune starts at the original ceiling, not the attenuated one
+	CHECK(chip.regs[0x13] == 0x037E && fd6818_agc_atten_db(&dev.agc) == 0);
+	(void)fd6818_am_status(&dev, 260);
+	fd6818_set_am(&dev, false);
+	CHECK(chip.regs[0x13] == 0x037E && chip.regs[0x47] == 0x0140);
+	chip.n = 0;
+	CHECK(fd6818_am_status(&dev, 511) == 0 && chip.n == 0);
+	fd6818_set_am(&dev, true);
+	(void)fd6818_am_status(&dev, 260);
+	fd6818_set_mode(&dev, FD6818_MODE_DMR);
+	CHECK(!dev.am && chip.regs[0x13] == 0x037E && chip.regs[0x47] == 0x0140);
+	CHECK(chip.regs[0x43] == FD6818_BW_DMR && chip.regs[0x4A] == 0x4567);
+	CHECK(chip.protocol_errors == 0);
+}
