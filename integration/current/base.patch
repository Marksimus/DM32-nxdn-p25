+		run_ms(30);
+
+		dmr_burst_t b;
+
+		memset(&b, 0, sizeof(b));
+		b.kind = DMR_BURST_PI_HEADER;
+		b.cc = 1;
+		b.crc_ok = true;
+		b.in_step = true;
+		b.len = 12;
