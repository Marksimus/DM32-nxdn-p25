+	// of many superframes (the indicator advances at each)
+	begin(0, &tx, &hooks_aes);
+	begin(1, &rx, &hooks);
+	over(100, 0, 0);
+	CHECK(r[1].call.algid == P25_ALGID_AES256 && r[1].call.kid == 5 && r[1].call.decrypt, "aes call: alg %02X kid %u decrypt %d", r[1].call.algid, r[1].call.kid, r[1].call.decrypt);
+	CHECK(r[1].nvoice >= 90 && r[1].voice_errs == 0, "aes call: %u frames, %u with errors", r[1].nvoice, r[1].voice_errs);
+	n = heard_in_order();
+	CHECK(n >= 90 && n == r[0].enc_made, "aes call: %u of %u encoded frames heard in order", n, r[0].enc_made);
+	// The same encoder frames would not arrive unless the voice on air was encrypted: radio 2 with no key hears none
+	// (below), and the frames on air are not the plain ones (the key stream is not all zero)
+	CHECK(mi_calls == 1, "one indicator for the call: %u", mi_calls);
+
+	// 2. A receiver with another key, or another key id, or none: the call is known, its voice is not handed on
+	rx.aes_key = keyB;
+	begin(0, &tx, &hooks_aes);
+	begin(1, &rx, &hooks);
+	over(60, 0, 0);
+	CHECK(r[1].starts == 1 && r[1].call.algid == P25_ALGID_AES256 && r[1].call.decrypt, "wrong key: the id matches, so it tries");
+	CHECK(heard_in_order() == 0, "wrong key: no frame equals what was sent");
+	rx.aes_key = keyA;
+	rx.aes_kid = 6;
+	begin(0, &tx, &hooks_aes);
+	begin(1, &rx, &hooks);
+	over(60, 0, 0);
+	CHECK(r[1].starts == 0 && r[1].nvoice == 0, "other key id: silent, not even a start (%u starts, %u frames)", r[1].starts, r[1].nvoice);
+	rx.aes_key = NULL;
+	rx.aes_kid = 5;
+	begin(0, &tx, &hooks_aes);
+	begin(1, &rx, &hooks);
+	over(60, 0, 0);
+	CHECK(r[1].starts == 0 && r[1].nvoice == 0, "no key: silent (%u starts, %u frames)", r[1].starts, r[1].nvoice);
+
+	// 3. Encryption asked for and no key: PTT is refused, nothing goes out in the clear
+	tx.aes_key = NULL;
+	begin(0, &tx, &hooks_aes);
+	CHECK(!p25_engine_tx_prepare(&r[0].e), "aes_tx without a key: no transmission");
+	tx.aes_key = keyA;
+	tx.aes_tx = false;
+	begin(0, &tx, &hooks_aes);
+	begin(1, &rx, &hooks);
+	rx.aes_key = keyA;
+	p25_engine_set(&r[1].e, &rx);
+	over(30, 0, 0);
+	CHECK(r[1].call.algid == P25_ALGID_CLEAR && r[1].nvoice > 0 && heard_in_order() == r[0].enc_made, "a clear call is still heard clear");
+	tx.aes_tx = true;
+
+	// 4. Late entry: radio 1 starts listening 40 periods into the call, so it has no header: the first LDU2's
+	// encryption sync gives it the indicator, and from there every frame it hands on is one that was sent
+	begin(0, &tx, &hooks_aes);
+	begin(1, &rx, &hooks);
+	CHECK(p25_engine_tx_prepare(&r[0].e), "late: queued");
+	prov[0].keyed = true;
+	CHECK(p25_engine_tx_go(&r[0].e), "late: go");
+	for (n = 0; n < 400; n++) {
+		if (n == 40)
+			begin(1, &rx, &hooks);		// a fresh receiver: it missed the header and the first LDUs
+		if (n == 100)
+			p25_engine_tx_stop(&r[0].e);
+		if (n < 100)
+			encode(&r[0], (uint8_t)(1 + (n & 1)));
+		step(0);
+		step(1);
+		if (p25_engine_tx_state(&r[0].e) == AIR_TX_DONE) {
+			prov[0].keyed = false;
+			p25_engine_tx_clear(&r[0].e);
+			break;
+		}
+	}
+	uint16_t foreign = 0, known = 0;
+	for (uint16_t i = 0; i < r[1].nvoice; i++) {
+		bool found = false;
+
+		if (!memcmp(r[1].voice[i], silence, P25_IMBE_BYTES))
+			continue;
+		for (uint16_t k = 0; k < r[0].enc_made && !found; k++)
+			found = !memcmp(r[1].voice[i], r[0].enc[k], P25_IMBE_BYTES);
+		known += found;
+		foreign += !found;
+	}
+	CHECK(r[1].call.late && r[1].call.decrypt, "late entry: late %d decrypt %d", r[1].call.late, r[1].call.decrypt);
+	CHECK(known >= 50 && foreign <= 9, "late entry: %u frames are the sender's, %u are not (at most the LDU before the indicator)", known, foreign);
+}
+#endif
+
 int main(void)
 {
 	testCall();
 	testSquelch();
+#if CONFIG_AIR_AES
+	testAes();
+#endif
 	printf("p25EngineTest: %d checks, %d failed\n", checks, failures);
 	return failures ? 1 : 0;
 }
