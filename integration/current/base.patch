+#if CONFIG_UI_KAWAII
+static void kawaii_grid(const ui_list_t *l, int y, int bottom)
+{
+	const ui_layout_t *L = &ui_layout;
+	const font_t *f = L->small;
+	int w = gfx_width(), pitch = l->count <= 8 && bottom - y >= 248 ? (bottom - y) / 4 : 77;
+	int rows = (bottom - y) / pitch;
+	if (rows < 1)
+		rows = 1;
+	uint16_t capacity = (uint16_t)(2 * rows), top = l->top != NULL ? *l->top : 0;
+	top &= (uint16_t)~1u;
+	if (l->focus < top)
+		top = l->focus & (uint16_t)~1u;
+	if (l->focus >= top + capacity)
+		top = (uint16_t)((l->focus / 2u - rows + 1u) * 2u);
+	if (l->top != NULL)
+		*l->top = top;
+	for (uint16_t i = top; i < l->count && i < top + capacity; i++) {
+		ui_item_t it = {0};
+		l->item(i, &it);
+		int col = (i - top) % 2, row = (i - top) / 2;
+		int x = col * (w / 2) + 3, ty = y + row * pitch + 4, cw = w / 2 - 6;
+		bool focus = i == l->focus;
+		color_t bg = focus ? ui_col.focus : ui_theme == 2 ? ui_col.bg : ROSE_CARD;
+		color_t fg = focus ? ui_col.focus_fg : (it.flags & UI_ITEM_DIM) ? ui_col.dim : ui_col.fg;
+		kawaii_card(x, ty, cw, pitch - 8, bg);
+		if (focus) {
+			kawaii_heart(x + 6, ty + 6, fg);
+			kawaii_heart(x + cw - 13, ty + 6, fg);
+		}
+		// A tiny numbered badge keeps the hardware's direct key shortcuts visible.
+		char key[2] = { it.num, 0 };
+		gfx_text(L->tiny, x + cw - L->tiny->w - 5, ty + 3, key, fg);
+		switch (i % 4u) {
+		case 0: kawaii_bow(x + cw / 2 - 9, ty + 11, ui_col.priv); break;
+		case 1: kawaii_heart(x + cw / 2 - 3, ty + 13, ui_col.priv); break;
+		case 2: kawaii_star(x + cw / 2 - 3, ty + 12, ui_col.priv); break;
+		default:
+			gfx_round_fill(x + cw / 2 - 10, ty + 9, 20, 13, ui_col.priv);
+			gfx_hline(x + cw / 2 - 6, ty + 14, 12, bg);
+			break;
+		}
+		char fit[48];
+		const font_t *lf = gfx_text_width(f, it.label) <= cw - 10 ? f : L->tiny;
+		if (gfx_text_width(lf, it.label) > cw - 10)
+			lf = &font_aa_6x12;
+		const char *rest = wrap_line(lf, it.label, cw - 10, fit, sizeof fit);
+		gfx_text(lf, x + (cw - gfx_text_width(lf, fit)) / 2, ty + 27, fit, fg);
+		if (*rest) {
+			gfx_text_fit(lf, rest, cw - 10, fit, sizeof fit);
+			gfx_text(lf, x + (cw - gfx_text_width(lf, fit)) / 2, ty + 27 + lf->h, fit, fg);
+		} else if (it.value[0]) {
+			gfx_text_fit(L->tiny, it.value, cw - 10, fit, sizeof fit);
+			gfx_text(L->tiny, x + (cw - gfx_text_width(L->tiny, fit)) / 2, ty + 45, fit, ui_col.dim);
+		}
+	}
+	if (top > 0)
+		gfx_fill(w - 3, y, 3, 3, ui_col.priv);
+	if (top + capacity < l->count)
+		gfx_fill(w - 3, bottom - 4, 3, 3, ui_col.priv);
+}
+#endif
 
